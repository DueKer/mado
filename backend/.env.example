# ============================================================
# MADO 后端环境变量配置示例
# 复制此文件为 .env 并填入真实的 API Key
# ============================================================

# OpenAI API（GPT 模型）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=

# Anthropic API（Claude 模型）
ANTHROPIC_API_KEY=sk-ant-xxx

# Groq API（免费，需翻墙）
GROQ_API_KEY=

# 硅基流动 API（免费，国内可用）
SILICONFLOW_API_KEY=

# 数据库地址（默认使用本地 SQLite）
DATABASE_URL=sqlite:///./data/mado.db

# CORS 允许的前端来源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
